{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": false,
    "noEmit": false,
    "outDir": "dist-cli"
  },
  "include": ["scripts/**/*.ts", "src/lib/binary.ts", "src/lib/screenbuffer.ts", "src/lib/utils.ts"]
}
